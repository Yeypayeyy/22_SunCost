<UserControl x:Class="SunCost.Views.HasilPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

  <Grid Margin="40,36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Judul -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Hasil Simulasi" FontSize="26" FontWeight="SemiBold"
                 Foreground="{StaticResource InkBrush}"/>
      <TextBlock x:Name="Ringkasan" FontSize="13" Foreground="{StaticResource MutedBrush}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Tabs -->
    <Border Grid.Row="1" Background="{StaticResource TrackBrush}" CornerRadius="10"
            Padding="4,4,0,4" Margin="0,20,0,0" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabEnergi" Content="Energi" GroupName="HasilTab" IsChecked="True"
                     Style="{StaticResource SegmentTab}"/>
        <RadioButton x:Name="TabFinansial" Content="Finansial &amp; Lingkungan" GroupName="HasilTab"
                     Style="{StaticResource SegmentTab}" Checked="TabFinansial_Checked"/>
      </StackPanel>
    </Border>

    <!-- KPI -->
    <UniformGrid Grid.Row="2" Rows="1" Margin="0,20,-16,0">
      <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoftBrush}"
              BorderBrush="{StaticResource AccentSoftBrush}" Padding="24,22" Margin="0,0,16,0"
              VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Produksi tahunan" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="ProduksiTahunan" FontSize="40" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,4"/>
          <TextBlock Text="kWh/tahun" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,16,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Rata-rata bulanan" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="RataBulanan" FontSize="30" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" Margin="0,4"/>
          <TextBlock Text="kWh/bulan" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,16,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Setara konsumsi" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="SetaraKonsumsi" FontSize="30" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" Margin="0,4"/>
          <TextBlock Text="dari tagihan saat ini" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Grafik + Asumsi -->
    <Grid Grid.Row="3" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Produksi Energi per Bulan" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="kWh · musim kemarau (Jul–Sep) menghasilkan paling banyak"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
          </StackPanel>

          <ItemsControl x:Name="Batang" Grid.Row="1" Margin="0,18,-10,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,10,0" ToolTip="{Binding Tooltip}">
                  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Bulan}" FontSize="11"
                             FontWeight="{Binding Bobot}" Foreground="{Binding WarnaTeks}"
                             HorizontalAlignment="Center" Margin="0,8,0,0"/>
                  <Border VerticalAlignment="Bottom" Height="{Binding Tinggi}"
                          Background="{Binding WarnaBatang}" CornerRadius="5,5,0,0"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
        <StackPanel>
          <TextBlock Text="Asumsi Perhitungan" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}"/>
          <TextBlock Text="Ditampilkan terbuka agar hasil dapat diperiksa ulang."
                     FontSize="12" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" Margin="0,14,0,0"/>
          <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="14"
                  Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Energi tahunan =" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="kWp × PSH × PR × 365" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <ItemsControl x:Name="Asumsi">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,14,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Nilai}" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                               Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Nama}" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Keterangan}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
