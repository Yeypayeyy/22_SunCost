<UserControl x:Class="SunCost.Views.BerandaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

  <StackPanel Margin="40,36">

    <!-- Hero -->
    <Border Style="{StaticResource Card}" CornerRadius="16" Padding="40">
      <StackPanel>
        <TextBlock Text="Berapa hemat listrik dari atap rumahmu?"
                   FontSize="34" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"
                   TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
        <TextBlock Text="Hitung produksi energi, penghematan tagihan, dan waktu balik modal panel surya — dengan seluruh asumsi perhitungan ditampilkan terbuka."
                   FontSize="15" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                   Margin="0,16,0,0"/>
        <Button Content="Mulai Simulasi" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0,20,0,0"
                Click="MulaiSimulasi_Click"/>
      </StackPanel>
    </Border>

    <TextBlock Text="Simulasi Terakhir" FontSize="16" FontWeight="SemiBold"
               Foreground="{StaticResource InkBrush}" Margin="0,28,0,12"/>

    <!-- Kartu riwayat terakhir -->
    <ItemsControl x:Name="RiwayatTerakhir">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
            <StackPanel>
              <TextBlock Text="{Binding Lokasi}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}"
                         TextTrimming="CharacterEllipsis"/>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                  <TextBlock Text="Kapasitas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock Text="{Binding KapasitasTeks}" FontSize="17" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Balik modal" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock Text="{Binding PaybackTeks}" FontSize="17" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}"/>
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Hemat per bulan" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding HematTeks}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource GreenBrush}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
