<UserControl x:Class="SunCost.Views.TentangPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

  <UserControl.Resources>
    <!-- Satu baris "label ........ nilai" -->
    <DataTemplate x:Key="BarisNilai">
      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Nilai}" FontSize="12" FontWeight="Medium"
                   Foreground="{Binding Warna}" Margin="12,0,0,0"/>
        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
      </DockPanel>
    </DataTemplate>

    <Style x:Key="JudulKartu" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,36">

      <TextBlock Text="Tentang SunCost" FontSize="26" FontWeight="SemiBold"
                 Foreground="{StaticResource InkBrush}"/>
      <TextBlock Text="Kalkulator kelayakan PLTS atap rumah tangga. Seluruh asumsi perhitungan ditampilkan terbuka."
                 FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

      <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Kolom kiri -->
        <StackPanel Grid.Column="0">

          <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
              <TextBlock Text="Tim Pengembang" Style="{StaticResource JudulKartu}"/>
              <ItemsControl x:Name="Tim">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="0,14">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Peran}" FontSize="11" FontWeight="Medium"
                                     Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="{Binding Nama}" FontSize="14" FontWeight="SemiBold"
                                     Foreground="{StaticResource InkBrush}"/>
                          <TextBlock Text="{Binding Nim}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                     Margin="0,2,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="22" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Rumus &amp; Konstanta" Style="{StaticResource JudulKartu}"/>
              <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Energi tahunan =" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock Text="kWp × PSH × PR × 365 × koreksi suhu" FontSize="13" FontWeight="Medium"
                             Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="Konstanta" ItemTemplate="{StaticResource BarisNilai}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Kolom kanan -->
        <StackPanel Grid.Column="2">

          <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
              <TextBlock Text="Sumber Data" Style="{StaticResource JudulKartu}"/>
              <ItemsControl x:Name="Sumber" ItemTemplate="{StaticResource BarisNilai}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="22" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Versi Aplikasi" Style="{StaticResource JudulKartu}"/>
              <ItemsControl x:Name="Versi" ItemTemplate="{StaticResource BarisNilai}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="22" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Disclaimer" FontSize="13" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}"/>
              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Margin="0,8,0,0" LineHeight="16"
                         Text="Hasil simulasi adalah estimasi dari data iklim historis dan asumsi yang ditampilkan terbuka. Angka sebenarnya dapat berbeda karena bayangan, kondisi atap, kualitas pemasangan, dan perubahan tarif. SunCost tidak terikat vendor mana pun."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
