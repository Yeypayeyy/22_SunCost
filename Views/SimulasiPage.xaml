<UserControl x:Class="SunCost.Views.SimulasiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,36">

      <TextBlock Text="Simulasi Baru" FontSize="26" FontWeight="SemiBold"
                 Foreground="{StaticResource InkBrush}"/>
      <TextBlock Text="Isi data atap dan tarif listrikmu. Estimasi kapasitas diperbarui otomatis."
                 FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

      <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Form ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
          <StackPanel>

            <!-- Banner galat (frame 7) -->
            <Border x:Name="Banner" Background="{StaticResource DangerSoftBrush}" CornerRadius="8"
                    Padding="14,12" Margin="0,0,0,18" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6"/>
                  <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="BannerTeks" FontSize="12" FontWeight="Medium" Margin="10,0,0,0"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Nama skenario -->
            <TextBlock Text="Nama skenario" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NamaBox" Style="{StaticResource FieldInput}"/>
            <TextBlock x:Name="NamaGalat" Style="{StaticResource FieldError}"/>
            <TextBlock Text="Contoh: Rumah Sleman, atap utara" Style="{StaticResource FieldHelper}"/>

            <!-- Lokasi -->
            <TextBlock Text="Lokasi" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <ComboBox x:Name="LokasiBox" Style="{StaticResource FieldCombo}"/>
            <TextBlock x:Name="KoordinatTeks" Style="{StaticResource FieldHelper}"/>

            <!-- Luas | Orientasi -->
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Luas atap tersedia" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LuasBox" Style="{StaticResource FieldInput}" Tag="m²" Text="32"/>
                <TextBlock x:Name="LuasGalat" Style="{StaticResource FieldError}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Orientasi atap" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ArahBox" Style="{StaticResource FieldCombo}"/>
              </StackPanel>
            </Grid>

            <!-- Kemiringan | Jenis panel -->
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Kemiringan atap" Style="{StaticResource FieldLabel}"/>
                <DockPanel Margin="0,11,0,0">
                  <TextBlock x:Name="KemiringanTeks" DockPanel.Dock="Right" Width="34" TextAlignment="Right"
                             FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                  <Slider x:Name="KemiringanSlider" Style="{StaticResource FieldSlider}"
                          Minimum="0" Maximum="45" Value="15"/>
                </DockPanel>
                <TextBlock Text="0° datar sampai 45° curam" Style="{StaticResource FieldHelper}" Margin="0,10,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Jenis panel" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PanelBox" Style="{StaticResource FieldCombo}"/>
              </StackPanel>
            </Grid>

            <!-- Biaya | Tagihan -->
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Biaya per Wp terpasang" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BiayaBox" Style="{StaticResource FieldInput}" Tag="Rp/Wp" Text="21.000"/>
                <TextBlock x:Name="BiayaGalat" Style="{StaticResource FieldError}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Tagihan listrik bulanan" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TagihanBox" Style="{StaticResource FieldInput}" Tag="kWh"/>
                <TextBlock x:Name="TagihanGalat" Style="{StaticResource FieldError}"/>
                <TextBlock Text="Opsional, untuk membandingkan dengan pemakaianmu" Style="{StaticResource FieldHelper}"/>
              </StackPanel>
            </Grid>

            <!-- Tarif PLN -->
            <TextBlock Text="Golongan tarif PLN" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <ComboBox x:Name="TarifBox" Style="{StaticResource FieldCombo}"/>
            <CheckBox x:Name="TarifManualCek" Content="Masukkan tarif sendiri" Style="{StaticResource FieldCheck}"
                      Margin="0,10,0,0"/>

            <!-- Tarif manual (frame 8) -->
            <StackPanel x:Name="TarifManualPanel" Visibility="Collapsed" Margin="0,18,0,0">
              <TextBlock Text="Tarif per kWh" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TarifManualBox" Style="{StaticResource FieldInput}" Tag="Rp/kWh"/>
              <TextBlock x:Name="TarifManualGalat" Style="{StaticResource FieldError}"/>
              <TextBlock Text="Dipakai menggantikan tarif golongan di atas." Style="{StaticResource FieldHelper}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================= Estimasi Langsung ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Estimasi Langsung" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"/>

            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="18,16" Margin="0,16,0,4">
              <StackPanel>
                <TextBlock Text="Kapasitas terpasang" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="KapasitasTeks" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="Estimasi">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Nilai}" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Semua asumsi di atas selalu ditampilkan lagi pada hasil akhir."
                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,18,0,0"/>

            <Button x:Name="Hitung" Content="Hitung Kelayakan" Style="{StaticResource PrimaryButton}"
                    FontSize="14" Padding="0,13" Margin="0,16,0,0" Click="Hitung_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
