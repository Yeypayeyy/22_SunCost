<Page x:Class="SunCost.Views.AdminReferensiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Admin - Kelola Data Referensi">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kelola Data Referensi" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Jenis Data:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbJenisData" Width="220" SelectionChanged="CmbJenisData_SelectionChanged">
                <ComboBoxItem Content="Radiasi Matahari"/>
                <ComboBoxItem Content="Karakteristik Panel"/>
                <ComboBoxItem Content="Tarif Listrik"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="GridReferensi" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"/>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Tambah" Click="BtnTambah_Click" Margin="0,0,10,0" Padding="10" Background="#2E7D32" Foreground="White"/>
            <Button Content="Ubah" Click="BtnUbah_Click" Margin="0,0,10,0" Padding="10" Background="#D79B00" Foreground="White"/>
            <Button Content="Hapus" Click="BtnHapus_Click" Padding="10" Background="#B85450" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>