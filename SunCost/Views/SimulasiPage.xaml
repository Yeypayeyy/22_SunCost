<Page x:Class="SunCost.Views.SimulasiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Buat Simulasi PLTS">
    <StackPanel Margin="30">
        <TextBlock Text="Buat Simulasi PLTS" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Lokasi (Kota)" Margin="0,10,0,5"/>
        <TextBox x:Name="TxtLokasi" Padding="5"/>

        <TextBlock Text="Luas Atap (m²)" Margin="0,10,0,5"/>
        <TextBox x:Name="TxtLuasAtap" Padding="5"/>

        <TextBlock Text="Orientasi Atap" Margin="0,10,0,5"/>
        <ComboBox x:Name="CmbOrientasi" Padding="5">
            <ComboBoxItem Content="Utara"/>
            <ComboBoxItem Content="Selatan"/>
            <ComboBoxItem Content="Timur"/>
            <ComboBoxItem Content="Barat"/>
        </ComboBox>

        <TextBlock Text="Kemiringan Atap (derajat)" Margin="0,10,0,5"/>
        <Slider x:Name="SliderKemiringan" Minimum="0" Maximum="45" TickFrequency="5" IsSnapToTickEnabled="True"/>

        <Button Content="Hitung Potensi Energi" Click="BtnHitung_Click" Margin="0,20,0,0" Padding="10" Background="#2E7D32" Foreground="White"/>

        <TextBlock x:Name="TxtHasil" Margin="0,20,0,0" FontStyle="Italic"/>
    </StackPanel>
</Page>