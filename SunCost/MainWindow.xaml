<Window x:Class="SunCost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunCost" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu navigasi atas -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#2E7D32" Height="50">
            <Button Content="Buat Simulasi" Click="NavigateToSimulasi" Margin="10,0" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Hasil Analisis" Click="NavigateToHasil" Margin="10,0" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Riwayat Simulasi" Click="NavigateToRiwayat" Margin="10,0" Foreground="White" Background="Transparent" BorderThickness="0"/>
            <Button Content="Admin" Click="NavigateToAdmin" Margin="10,0" Foreground="White" Background="Transparent" BorderThickness="0"/>
        </StackPanel>

        <!-- Tempat halaman ditampilkan -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>