<Window x:Class="SunCost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SunCost.Views"
        Title="SunCost — Kalkulator PLTS Atap"
        Height="800" Width="1280"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="20,28">
        <TextBlock Text="SunCost" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="Kalkulator PLTS Atap" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,28"/>

        <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectedIndex="0">
          <ListBoxItem Content="Beranda"/>
          <ListBoxItem Content="Simulasi Baru"/>
          <ListBoxItem Content="Riwayat"/>
          <ListBoxItem Content="Tentang"/>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Area konten -->
    <ContentControl Grid.Column="1">
      <views:BerandaPage/>
    </ContentControl>
  </Grid>
</Window>
