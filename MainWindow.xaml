<Window x:Class="SunCost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SunCost.Views"
        Title="SunCost - Kalkulator PLTS Atap"
        Icon="Assets/suncost.ico"
        Height="800" Width="1280"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBrush}">

  <!-- Garis atas memisahkan title bar Windows dari isi aplikasi, termasuk di atas sidebar putih -->
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="20,28">

          <!-- Logo A1 "Atap & Matahari", sama dengan vektor di Figma (halaman Opsi Visual) -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
            <Viewbox Width="34" Height="34" VerticalAlignment="Center">
              <Canvas Width="64" Height="64">
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M47,2 V5.5 M60,8 L57.4,10.6 M63,19 H59.5 M34,8 L36.6,10.6"/>
                <Ellipse Canvas.Left="38" Canvas.Top="10" Width="18" Height="18"
                         Fill="{StaticResource AccentBrush}"/>
                <Path Fill="{StaticResource InkBrush}" Data="M3,38 L32,16 L61,38 Z"/>
                <Path Stroke="{StaticResource CanvasBrush}" StrokeThickness="1.8"
                      Data="M14,31 H50 M32,17.5 V37.5"/>
                <Path Stroke="{StaticResource InkBrush}" StrokeThickness="3.5" StrokeLineJoin="Round"
                      Data="M10,38 V58 H54 V38"/>
                <Path Stroke="{StaticResource InkBrush}" StrokeThickness="3"
                      Data="M27,58 V47 H37 V58"/>
              </Canvas>
            </Viewbox>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SunCost" FontSize="20" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}"/>
              <TextBlock Text="Kalkulator PLTS Atap" FontSize="11"
                         Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </StackPanel>

          <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent"
                   ItemContainerStyle="{StaticResource NavItem}"
                   SelectedIndex="0" SelectionChanged="Nav_SelectionChanged">
            <ListBoxItem Content="Beranda"/>
            <ListBoxItem Content="Simulasi Baru"/>
            <ListBoxItem Content="Riwayat"/>
            <ListBoxItem Content="Tentang"/>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Area konten -->
      <ContentControl x:Name="Konten" Grid.Column="1">
        <views:BerandaPage/>
      </ContentControl>
    </Grid>
  </Border>
</Window>
